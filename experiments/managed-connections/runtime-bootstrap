#!/bin/sh
set -eu

# The daemon remains non-root with its original capability set. Legacy
# iptables inspection needs read access to these namespace-local proc entries.
if [ "$(id -u)" = 0 ]; then
  for names in /proc/net/ip_tables_names /proc/net/ip6_tables_names; do
    if [ -e "$names" ]; then
      chmod a+r "$names"
    fi
  done
fi

exec /usr/bin/setpriv "$@"
