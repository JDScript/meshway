#!/bin/sh
set -eu

if [ "$(id -u)" -eq 0 ]; then
  : "${MESHWAY_AGENT_UID:?missing recorded Agent UID}"
  : "${MESHWAY_AGENT_GID:?missing recorded Agent GID}"
  case "$MESHWAY_AGENT_UID" in ""|0|*[!0-9]*) echo "invalid recorded Agent UID" >&2; exit 64 ;; esac
  case "$MESHWAY_AGENT_GID" in ""|*[!0-9]*) echo "invalid recorded Agent GID" >&2; exit 64 ;; esac
  exec setpriv --reuid "$MESHWAY_AGENT_UID" --regid "$MESHWAY_AGENT_GID" --clear-groups \
    --bounding-set=-all --inh-caps=-all --ambient-caps=-all --no-new-privs \
    /usr/local/bin/meshway-agent "$@"
fi

exec /usr/local/bin/meshway-agent "$@"
