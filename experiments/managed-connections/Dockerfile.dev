# syntax=docker/dockerfile:1
# Writable developer image. Build from the workspace root; runtime state remains a host-owned bind.
FROM rust:1.98-slim-bookworm@sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730 AS builder
ARG TARGETARCH
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config libsqlite3-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps/agent ./apps/agent
COPY apps/controller ./apps/controller
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target,id=meshway-managed-dev-${TARGETARCH},sharing=locked \
    cargo build --locked --release -p meshway-controller -p meshway-agent --bin meshway-controller --bin meshway-agent --features meshway-agent/managed-connections \
    && install -D target/release/meshway-agent /out/meshway-agent \
    && install -D target/release/meshway-controller /out/meshway-controller

FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash ca-certificates curl iproute2 iputils-ping python3 traceroute util-linux \
    && find /var/lib/apt/lists -type f -name '*Packages*' -print -quit | grep -q .
COPY --from=builder /out/meshway-agent /out/meshway-controller /usr/local/bin/
COPY experiments/managed-connections/meshway-dev-launcher /usr/local/bin/meshway
RUN chmod 0755 /usr/local/bin/meshway && test "$(readlink -f /bin/sh)" = /usr/bin/dash
ENV MESHWAY_STATE=/state/agent.json
COPY experiments/managed-connections/container.py /opt/meshway-managed/container.py
ENTRYPOINT ["sleep", "infinity"]
