# Main supplies an existing native Ubuntu/Debian image containing the real
# controller+Agent binaries built with meshway-agent/managed-connections.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER 0:0
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    dnsutils python3 iproute2 \
    && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["sleep", "infinity"]
