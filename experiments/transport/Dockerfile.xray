# syntax=docker/dockerfile:1
ARG XRAY_IMAGE=ghcr.io/xtls/xray-core@sha256:592ec4d11f656db95598d01e76dbcc6e002d67360b96a5436500a938230f52c7
ARG LAB_IMAGE=meshway-agent-lab:xray-base-d9bce9aad768
FROM ${XRAY_IMAGE} AS xray
FROM ${LAB_IMAGE}
ARG XRAY_IMAGE
ARG LAB_IMAGE
ARG LAB_IMAGE_ID=sha256:d9bce9aad7687f81733fb2d64a68b8671bcc8751bda72da8007f6cdb99e1d823
LABEL io.meshway.xray.source="${XRAY_IMAGE}" io.meshway.xray.lab-base="${LAB_IMAGE}" io.meshway.xray.lab-base-id="${LAB_IMAGE_ID}"
# Preserve every lab package, including iperf3. No package installation/upgrade.
COPY --from=xray /usr/local/bin/xray /usr/local/bin/xray
RUN xray version && iperf3 --version && openssl version
# Fixture explicitly overrides the inherited meshway-agent entrypoint with Python.
