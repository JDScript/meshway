/target
/.worktree/
**/node_modules/
**/out/
**/dist/
# Root dist/ holds the shipped systemd unit and installer, not build output.
!/dist/
**/.vitepress/cache/
**/.vitepress/dist/
**/*.tsbuildinfo
**/__pycache__/
.DS_Store
.env
.env.*
!.env.example
/.meshway/
/docs/public/status/index.json
# Rendered from packages/protocol/openapi.json on every docs build.
/docs/v2/reference/

# Independent upstream checkouts; retain the reproducible research index.
/references/*
!/references/README.md
