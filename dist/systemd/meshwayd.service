[Unit]
Description=Meshway Node daemon
Documentation=https://github.com/JDScript/meshway/blob/main/docs/v2/install.md
Wants=network-online.target
After=network-online.target systemd-resolved.service dbus.service

[Service]
Type=notify
NotifyAccess=main
# MESHWAY_SERVER_URL (required) and optional MESHWAYD_OPTIONS, written by install.sh.
EnvironmentFile=/etc/meshway/meshwayd.env
Environment=MESHWAY_LOG_FORMAT=json RUST_LOG=info
ExecStart=/usr/local/bin/meshwayd --data-dir /var/lib/meshway $MESHWAYD_OPTIONS
Restart=on-failure
RestartSec=5s
# SIGTERM to the daemon only: it cancels and joins its own nft children.
KillMode=mixed
TimeoutStartSec=60s
TimeoutStopSec=45s

# Private machine state (identity, netmap.json, journals) and control.sock.
StateDirectory=meshway
StateDirectoryMode=0700
# Namespace DNS ownership records live here; they must survive daemon restarts
# within one boot (the DNS anchor is kept until an explicit down).
RuntimeDirectory=meshway
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077

# Root without the rest of root: TUN/routes/nft (NET_ADMIN), protected sockets
# (NET_RAW), the resolv-conf backend's port 53 (NET_BIND_SERVICE), and reading
# systemd-resolved's /proc/<pid>/ns/net across its UID (SYS_PTRACE).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectHostname=yes
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
