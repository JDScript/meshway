[Unit]
Description=Meshway Server
Documentation=https://github.com/JDScript/meshway/blob/main/docs/v2/install.md
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=meshway-server
Group=meshway-server
# MESHWAY_* instance settings (listen, Console origin, registration …) and
# optional MESHWAY_SERVER_OPTIONS; created once by install.sh, then the
# operator's file.
EnvironmentFile=/etc/meshway-server/server.env
Environment=MESHWAY_LOG_FORMAT=json RUST_LOG=info
ExecStart=/usr/local/bin/meshway-server --data-dir /var/lib/meshway-server $MESHWAY_SERVER_OPTIONS
Restart=on-failure
RestartSec=5s
# Persistent storage blocks (unsupported or damaged schema, failed proof,
# master-key mismatch) exit 78 and are not restarted into.
RestartPreventExitStatus=78
# A migration extends this with EXTEND_TIMEOUT_USEC at every step.
TimeoutStartSec=120s
TimeoutStopSec=30s
LimitNOFILE=65536

StateDirectory=meshway-server
StateDirectoryMode=0700
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
