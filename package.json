{
  "name": "meshway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "python3 scripts/dev.py start",
    "dev:status": "python3 scripts/dev.py status",
    "dev:stop": "python3 scripts/dev.py stop",
    "dev:restart": "python3 scripts/dev.py restart",
    "dev:update": "python3 scripts/dev.py update",
    "dev:console": "pnpm --filter @meshway/console dev",
    "dev:docs": "pnpm --filter @meshway/docs dev",
    "build:console": "pnpm --filter @meshway/console build",
    "build:docs": "pnpm --filter @meshway/docs build",
    "build": "pnpm build:console && pnpm build:docs",
    "protocol:generate": "pnpm --filter @meshway/control-client generate",
    "protocol:check": "pnpm --filter @meshway/control-client check:generated",
    "test:protocol": "pnpm --filter @meshway/control-client test",
    "test:codegen": "node --test scripts/generate-protocol.test.mjs",
    "test:console": "pnpm --filter @meshway/console test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:docs": "pnpm --filter @meshway/docs check",
    "test:scripts": "python3 -B -m unittest discover -s scripts -p 'test_*.py'",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "typescript": "5.9.3"
  }
}
