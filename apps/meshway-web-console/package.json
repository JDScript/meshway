{
  "name": "@meshway/web-console",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001 --strictPort",
    "build": "pnpm run i18n && tsc -b && vite build",
    "preview": "vite preview --port 3001 --strictPort",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
    "typecheck": "pnpm run i18n && tsr generate && tsc -b",
    "lint": "eslint --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/ .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "format": "prettier --write \"**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier \"**/*.{ts,tsx,css,json}\"",
    "test": "pnpm run i18n && vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@meshway/control-client": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.49.0",
    "motion": "13.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "4.21.0",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.3"
  }
}
