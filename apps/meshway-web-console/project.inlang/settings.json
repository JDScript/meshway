{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "zh",
  "locales": ["zh", "en"],
  "modules": ["./node_modules/@inlang/plugin-message-format/dist/index.js"],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}.json",
      "./messages/entry/{locale}.json",
      "./messages/network/{locale}.json",
      "./messages/members/{locale}.json",
      "./messages/settings/{locale}.json",
      "./messages/account/{locale}.json",
      "./messages/configuration/{locale}.json",
      "./messages/nodes/{locale}.json",
      "./messages/live/{locale}.json",
      "./messages/overview/{locale}.json",
      "./messages/history/{locale}.json",
      "./messages/observation/{locale}.json",
      "./messages/debug/{locale}.json"
    ]
  }
}
