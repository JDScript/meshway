{
  "name": "@meshway/web-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "dev": "pnpm run generate:api && next dev --port 3002",
    "build": "pnpm run generate:api && next build",
    "typecheck": "pnpm run generate:api && next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/ .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,json,mdx}\"",
    "format:check": "prettier --check --cache \"**/*.{ts,tsx,mjs,css,json,mdx}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@meshway/control-client": "workspace:*",
    "@meshway/ui": "workspace:*",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-openapi": "12.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.16.2",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.2"
  }
}
