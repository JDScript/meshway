# Controller HTTP API，仅在服务端读取，用户不能在页面中修改。
MESHWAY_CONTROLLER_URL=http://127.0.0.1:8420
# VitePress 文档站地址，构建时内联到客户端。
NEXT_PUBLIC_DOCS_URL=http://localhost:5173
# 管理员会话 Cookie（HttpOnly、SameSite=Strict、8 小时）的 Secure 属性：
#   auto  （默认）浏览器经 HTTPS 访问控制台时设置 Secure；
#   true  始终设置，部署在 HTTPS 或 TLS 反向代理之后时推荐；
#   false 从不设置，仅用于纯 HTTP 的本地开发。
# 其他取值按 true 处理。
MESHWAY_WEB_COOKIE_SECURE=auto
