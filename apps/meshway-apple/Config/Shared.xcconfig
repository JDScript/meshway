MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
CLANG_ENABLE_MODULES = YES
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM =
MESHWAY_BUNDLE_PREFIX = dev.example
CURRENT_PROJECT_VERSION = 9
MARKETING_VERSION = 0.1
#include? "Local.xcconfig"
MESHWAY_APP_ID = $(MESHWAY_BUNDLE_PREFIX).meshway
MESHWAY_EXTENSION_ID = $(MESHWAY_APP_ID).PacketTunnel
MESHWAY_APP_GROUP = $(DEVELOPMENT_TEAM).$(MESHWAY_APP_ID)
MESHWAY_MACH_SERVICE = $(MESHWAY_APP_GROUP).ipc
OTHER_LDFLAGS = $(inherited) -framework Security -framework SystemConfiguration -framework CoreFoundation
