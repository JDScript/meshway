// Override locally (untracked) or with xcodebuild KEY=value. No team is assumed.
MESHWAY_BUNDLE_PREFIX = dev.example
MESHWAY_APP_GROUP = group.$(MESHWAY_BUNDLE_PREFIX).meshway
DEVELOPMENT_TEAM =
#include? "Local.xcconfig"
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
// The first XCFramework contains arm64 only on all three Apple platforms.
ARCHS = arm64
ALWAYS_SEARCH_USER_PATHS = NO
MACOSX_DEPLOYMENT_TARGET = 14.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SUPPORTS_MACCATALYST = NO
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
