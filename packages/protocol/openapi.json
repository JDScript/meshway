  "components": {
    "schemas": {
      "AcknowledgeConfigurationRequest": {
        "type": "object",
        "required": [
          "revision",
          "digest"
        ],
        "properties": {
          "digest": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "maximum": 4294967295,
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "AcknowledgeConfigurationResponse": {
        "type": "object",
        "required": [
          "revision",
          "digest"
        ],
        "properties": {
          "digest": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "maximum": 4294967295,
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "AgentNodeResponse": {
        "type": "object",
        "description": "Also lets a pending local enrollment recover its server-assigned node ID.",
        "required": [
          "node"
        ],
        "properties": {
          "node": {
            "$ref": "#/components/schemas/NodeSummary"
          }
        },
        "additionalProperties": false
      },
      "ConfigurationSnapshot": {
        "type": "object",
        "required": [
          "digest",
          "payload"
        ],
        "properties": {
          "digest": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "payload": {
            "$ref": "#/components/schemas/NodeConfiguration"
          }
        },
        "additionalProperties": false
      },
      "CreateEnrollmentTokenRequest": {
        "type": "object",
        "required": [
          "expires_in_seconds"
        ],
        "properties": {
          "expires_in_seconds": {
            "type": "integer",
            "format": "int32",
            "maximum": 86400,
            "minimum": 60
          }
        },
        "additionalProperties": false
      },
      "CreateEnrollmentTokenResponse": {
        "type": "object",
        "description": "The token is revealed only once, in this creation response.",
        "required": [
          "token_id",
          "token",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string"
          },
          "token_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DefaultRouteAction": {
        "type": "string",
        "enum": [
          "direct",
          "reject"
        ]
      },
      "DestinationScope": {
        "type": "string",
        "enum": [
          "any",
          "mesh",
          "internet"
        ]
      },
      "DestinationSelector": {
