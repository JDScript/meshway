{
  "openapi": "3.1.0",
  "info": {
    "title": "Meshway Controller",
    "description": "Utoipa's axum bindings for seamless integration for the two",
    "contact": {
      "name": "Juha Kukkonen",
      "email": "juha7kukkonen@gmail.com"
    },
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionIssuedResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Current session revoked"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "userSession": []
          }
        ]
      }
    },
    "/api/v1/auth/options": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "getAuthOptions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthOptionsResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionIssuedResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "getAuthSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "userSession": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthOptionsResponse": {
        "type": "object",
        "required": [
          "requestId",
          "registrationEnabled",
          "passwordRules"
        ],
        "properties": {
          "passwordRules": {
            "$ref": "#/components/schemas/PasswordRules"
          },
          "registrationEnabled": {
            "type": "boolean"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "additionalProperties": false
      },
      "AuthSessionResponse": {
        "type": "object",
        "required": [
          "requestId",
          "user",
          "session"
        ],
        "properties": {
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          },
          "session": {
            "$ref": "#/components/schemas/SessionMetadata"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          }
        },
        "additionalProperties": false
      },
      "EmptyParams": {
        "type": "object",
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "requestId",
          "status",
          "problem"
        ],
        "properties": {
          "problem": {
            "$ref": "#/components/schemas/Problem"
          },
          "requestId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RequestId",
                "description": "Null only when secure request-ID generation itself is unavailable."
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "$ref": "#/components/schemas/WireSecret"
          }
        },
        "additionalProperties": false
      },
      "PasswordLengthUnit": {
        "type": "string",
        "enum": [
          "unicodeCodepoints"
        ]
      },
      "PasswordRules": {
        "type": "object",
        "required": [
          "minCodepoints",
          "maxCodepoints",
          "maxUtf8Bytes",
          "lengthUnit"
        ],
        "properties": {
          "lengthUnit": {
            "$ref": "#/components/schemas/PasswordLengthUnit"
          },
          "maxCodepoints": {
            "type": "integer",
            "minimum": 0
          },
          "maxUtf8Bytes": {
            "type": "integer",
            "minimum": 0
          },
          "minCodepoints": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_credentials"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_session"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "registration_disabled"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "email_taken"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "password_weak"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/PasswordRules"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "request_too_large"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unsupported_media_type"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "busy"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "service_unavailable"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "not_found"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "method_not_allowed"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "$ref": "#/components/schemas/WireSecret"
          }
        },
        "additionalProperties": false
      },
      "RequestId": {
        "type": "string",
        "format": "uuid",
        "description": "Request identifier.\n\n This is an identifier, not a credential. Generation and authorization\n belong to the caller. Parsing rejects aliases rather than normalizing them.",
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "SessionId": {
        "type": "string",
        "format": "uuid",
        "description": "User session record identifier; not the session token.\n\n This is an identifier, not a credential. Generation and authorization\n belong to the caller. Parsing rejects aliases rather than normalizing them.",
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "SessionIssuedResponse": {
        "type": "object",
        "description": "First delivery only. Session reads never return the token.",
        "required": [
          "requestId",
          "user",
          "session",
          "token"
        ],
        "properties": {
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          },
          "session": {
            "$ref": "#/components/schemas/SessionMetadata"
          },
          "token": {
            "$ref": "#/components/schemas/WireSecret"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          }
        },
        "additionalProperties": false
      },
      "SessionMetadata": {
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "expiresAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "$ref": "#/components/schemas/SessionId"
          }
        },
        "additionalProperties": false
      },
      "UserId": {
        "type": "string",
        "format": "uuid",
        "description": "Stable user identifier.\n\n This is an identifier, not a credential. Generation and authorization\n belong to the caller. Parsing rejects aliases rather than normalizing them.",
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "UserView": {
        "type": "object",
        "description": "A user account; this view grants no network or instance privileges.",
        "required": [
          "id",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Canonical login identifier, not proof of email ownership."
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          }
        },
        "additionalProperties": false
      },
      "WireSecret": {
        "type": "string",
        "description": "Secret wire string. Serialization and borrowing are explicit; Debug, Display,\nand Clone are deliberately unavailable. The owned buffer is wiped on drop."
      }
    },
    "securitySchemes": {
      "userSession": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
