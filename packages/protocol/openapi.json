  "components": {
    "schemas": {
      "AuthOptionsResponse": {
        "type": "object",
        "required": [
          "requestId",
          "registrationEnabled",
          "passwordRules"
        ],
        "properties": {
          "passwordRules": {
            "$ref": "#/components/schemas/PasswordRules"
          },
          "registrationEnabled": {
            "type": "boolean"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "additionalProperties": false
      },
      "AuthSessionResponse": {
        "type": "object",
        "required": [
          "requestId",
          "user",
          "session"
        ],
        "properties": {
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          },
          "session": {
            "$ref": "#/components/schemas/SessionMetadata"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          }
        },
        "additionalProperties": false
      },
      "CreateNetworkRequest": {
        "type": "object",
        "required": [
          "requestId",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "additionalProperties": false
      },
      "EmptyParams": {
        "type": "object",
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "requestId",
          "status",
          "problem"
        ],
        "properties": {
          "problem": {
            "$ref": "#/components/schemas/Problem"
          },
          "requestId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RequestId",
                "description": "Null only when secure request-ID generation itself is unavailable."
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "maximum": 65535,
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "$ref": "#/components/schemas/WireSecret"
          }
        },
        "additionalProperties": false
      },
      "MemberSummary": {
        "type": "object",
        "required": [
          "membershipId",
          "userId",
          "email",
          "role",
          "version",
          "joinedAt"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "membershipId": {
            "$ref": "#/components/schemas/MembershipId"
          },
          "role": {
            "$ref": "#/components/schemas/MembershipRole"
          },
          "userId": {
            "$ref": "#/components/schemas/UserId"
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        },
        "additionalProperties": false
      },
      "MembershipId": {
        "type": "string",
        "format": "uuid",
        "description": "Network membership identifier.\n\n This is an identifier, not a credential. Generation and authorization\n belong to the caller. Parsing rejects aliases rather than normalizing them.",
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "MembershipRole": {
        "type": "string",
        "description": "A user's role within one network; this does not grant instance privileges.",
        "enum": [
          "owner",
          "admin",
          "member"
        ]
      },
      "NetworkActions": {
        "type": "object",
        "required": [
          "rename",
          "editConfiguration",
          "manageMembers"
        ],
        "properties": {
          "editConfiguration": {
            "type": "boolean"
          },
          "manageMembers": {
            "type": "boolean"
          },
          "rename": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "NetworkId": {
        "type": "string",
        "format": "uuid",
        "description": "Isolated network identifier.\n\n This is an identifier, not a credential. Generation and authorization\n belong to the caller. Parsing rejects aliases rather than normalizing them.",
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "NetworkListResponse": {
        "type": "object",
        "required": [
          "requestId",
          "items",
          "nextCursor",
          "asOf"
        ],
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NetworkSummary"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "additionalProperties": false
      },
      "NetworkMembersResponse": {
        "type": "object",
        "required": [
          "requestId",
          "items",
          "nextCursor",
          "asOf"
        ],
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberSummary"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "additionalProperties": false
      },
      "NetworkResponse": {
        "type": "object",
        "required": [
          "requestId",
          "network"
        ],
        "properties": {
          "network": {
            "$ref": "#/components/schemas/NetworkSummary"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "additionalProperties": false
      },
      "NetworkSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "createdAt",
          "currentRevision",
          "membershipId",
          "role",
          "actions"
        ],
        "properties": {
          "actions": {
            "$ref": "#/components/schemas/NetworkActions"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "currentRevision": {
            "$ref": "#/components/schemas/Revision"
          },
          "id": {
            "$ref": "#/components/schemas/NetworkId"
          },
          "membershipId": {
            "$ref": "#/components/schemas/MembershipId"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MembershipRole"
          }
        },
        "additionalProperties": false
      },
      "PasswordLengthUnit": {
        "type": "string",
        "enum": [
          "unicodeCodepoints"
        ]
      },
      "PasswordRules": {
        "type": "object",
        "required": [
          "minCodepoints",
          "maxCodepoints",
          "maxUtf8Bytes",
          "lengthUnit"
        ],
        "properties": {
          "lengthUnit": {
            "$ref": "#/components/schemas/PasswordLengthUnit"
          },
          "maxCodepoints": {
            "type": "integer",
            "format": "int32",
            "maximum": 65535,
            "minimum": 0
          },
          "maxUtf8Bytes": {
            "type": "integer",
            "format": "int32",
            "maximum": 65535,
            "minimum": 0
          },
          "minCodepoints": {
            "type": "integer",
            "format": "int32",
            "maximum": 65535,
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_credentials"
                ]
              },
              "message": {
                "type": "string"
              },
              "params": {
                "$ref": "#/components/schemas/EmptyParams"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "code",
              "params",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_session"
                ]
              },
