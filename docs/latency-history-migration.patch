# Candidate only; coordinator chooses expected_version/new_version and registers
# the one-shot transaction in the unified migration chain (v10 is already owned).
# NOT applied by normal Store::open and NOT a claim of a validated live migration.
diff --git a/apps/controller/src/store/latency_history/migration.rs b/apps/controller/src/store/latency_history/migration.rs
new file mode 100644
--- /dev/null
+++ b/apps/controller/src/store/latency_history/migration.rs
@@ -0,0 +1,33 @@
+use crate::Error;
+use rusqlite::{Connection, TransactionBehavior, params};
+
+pub(crate) fn migrate(
+    connection: &mut Connection,
+    expected_version: u32,
+    new_version: u32,
+) -> Result<(), Error> {
+    let version: u32 = connection.pragma_query_value(None, "user_version", |r| r.get(0))?;
+    if version != expected_version || new_version <= expected_version {
+        return Err(Error::Configuration("unexpected coordinated latency migration version"));
+    }
+    let tx = connection.transaction_with_behavior(TransactionBehavior::Immediate)?;
+    tx.execute_batch(include_str!("schema.sql"))?;
+    // Preexisting runtime leases have no known acquisition timestamp in this
+    // schema. Use a conservative history-activation floor, not an invented old
+    // measurement/lease time. No sample is generated by migration.
+    tx.execute(
+        "INSERT OR IGNORE INTO latency_runtime_epochs(node_id,network_id,epoch,started_ms)
+         SELECT node_id,network_id,epoch,?1 FROM connection_runtime_leases",
+        params![chrono::Utc::now().timestamp_millis()],
+    )?;
+    // Retained samples continue enforcing immutable IDs; rolling eviction copies
+    // any live retry/rate identity into the bounded admission ledger. The rate
+    // query unions retained receipts and ledger receipts during transition.
+    super::validate_schema(&tx)?;
+    tx.pragma_update(None, "user_version", new_version)?;
+    tx.commit()?;
+    Ok(())
+}
+
+// Coordinator adds `mod migration;` and the appropriate one-shot dispatcher
+// call, then revalidates real previous-version fixtures and restart integrity.
