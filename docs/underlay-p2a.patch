@@ -0,0 +1,56 @@
+//! P2a ownership adapter. No duplicate FD ledger or raw stream escape hatch.
+use std::{future::Future, io, net::SocketAddr, pin::Pin};
+use tokio::net::{TcpSocket, TcpStream};
+use crate::managed_connections::sockets::{self, Protection};
+use super::{BootstrapResolver, Purpose, SocketFactory, SystemDnsSnapshot};
+
+pub(crate) struct ManagedProtection {
+    factory: SocketFactory,
+    resolver: BootstrapResolver,
+}
+
+impl ManagedProtection {
+    pub(crate) fn new(factory: SocketFactory, upstreams: SystemDnsSnapshot) -> Self {
+        let resolver = BootstrapResolver::new(factory.clone(), upstreams);
+        Self { factory, resolver }
+    }
+}
+
+impl Protection for ManagedProtection {
+    fn resolve<'a>(&'a self, host: &'a str, port: u16) -> Pin<Box<dyn Future<Output = io::Result<Vec<SocketAddr>>> + Send + 'a>> {
+        Box::pin(async move {
+            self.resolver.resolve(Purpose::Carrier, host).await.map(|addresses| {
+                addresses.into_iter().map(|address| SocketAddr::new(address, port)).collect()
+            })
+        })
+    }
+    fn prepare(&self, _: SocketAddr, _: sockets::Purpose<'_>) -> io::Result<TcpSocket> {
+        // This legacy return type has no ownership/fence guard. Never hand out
+        // an untracked raw FD from a prepared protected generation.
+        Err(io::Error::new(io::ErrorKind::Unsupported, "protected sockets require the owned listen/dial seam"))
+    }
+    fn accepted(&self, _: &TcpStream, _: &str) -> io::Result<()> {
+        Err(io::Error::new(io::ErrorKind::Unsupported, "protected accepted streams require owned listener inheritance validation"))
+    }
+    fn listen(&self, address: SocketAddr, listener_id: &str) -> io::Result<sockets::OuterListener> {
+        if listener_id.is_empty() {
+            return Err(super::invalid("missing internal listener binding"));
+        }
+        self.factory.listener(Purpose::Carrier, address).map(sockets::OuterListener::Protected)
+    }
+    fn dial<'a>(
+        &'a self,
+        address: SocketAddr,
+        candidate_id: &'a str,
+        peer_node_id: &'a str,
+    ) -> Pin<Box<dyn Future<Output = io::Result<sockets::OuterTcp>> + Send + 'a>> {
+        Box::pin(async move {
+            if candidate_id.is_empty() || peer_node_id.is_empty() {
+                return Err(super::invalid("missing internal outgoing candidate / peer binding"));
+            }
+            // Session retains IDs in StreamContext; they are not bypass selectors
+            // or substitute access authorization. Every candidate gets a new FD.
+            self.factory.tcp(Purpose::Carrier, address).await.map(sockets::OuterTcp::Protected)
+        })
+    }
+}
